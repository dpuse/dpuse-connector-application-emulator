{
    "name": "@dpuse/dpuse-connector-application-emulator",
    "version": "0.0.68",
    "private": false,
    "description": "Provides read-only sample data simulating an application such as Salesforce or SAP.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-connector-application-emulator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-connector-application-emulator.git"
    },
    "module": "./dist/dpuse-connector-application-emulator.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/dpuse-connector-application-emulator.es.js",
            "types": "./dist/types/src/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.11.1": true,
        "workerd@1.20260930.2": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('BSD-3-Clause;MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && gh release create \"v$(npm pkg get version | tr -d '\"')\" --target \"$(git rev-parse HEAD)\" --generate-notes --latest",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.865",
        "nanoid": "^6.0.1"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^0.3.802",
        "@dpuse/dpuse-tool-adaltas-csv-parser": "^0.0.166",
        "@dpuse/dpuse-tool-file-previewer": "^0.0.66",
        "@dpuse/dpuse-tool-rust-csv-core-parser": "^0.1.46",
        "@dpuse/eslint-config-dpuse": "^1.0.124",
        "@types/node": "^26.6.3",
        "eslint": "^10.11.0",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.3",
        "wrangler": "^4.145.0"
    }
}
